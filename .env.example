# Copy to .env and fill in. .env is gitignored.

# --- which model ---------------------------------------------------------
# gemini | openai_compatible | mock
LLM_PROVIDER=gemini
# Model IDs churn (gemini-2.5-flash is deprecated; shutdown 2026-12-01). If a call
# 404s, check https://aistudio.google.com/docs/models and change these two lines.
LLM_MODEL=gemini-3.6-flash          # Pass 1 selector
JUDGE_MODEL=gemini-3.5-flash-lite   # Pass 2 judge (different model = partial independence)

# --- keys ----------------------------------------------------------------
# Free key: https://aistudio.google.com/apikey
GEMINI_API_KEY=

# For any OpenAI-shaped endpoint (OpenRouter, Groq, vLLM, a provider Kuku gives you):
#   LLM_PROVIDER=openai_compatible
#   LLM_MODEL=<model name that endpoint expects>
#   OPENAI_API_KEY=...
#   OPENAI_BASE_URL=https://openrouter.ai/api/v1

# --- free-tier pacing ------------------------------------------------------
# Check Google's current rate-limit page and set this at or below your RPM.
LLM_RPM=10

# --- optional --------------------------------------------------------------
# LLM_THINKING_BUDGET=0            # Gemini 2.5 Flash thinking tokens (0 = off, fastest)
# LLM_USE_RESPONSE_SCHEMA=1        # opt in to Gemini structured-output schema
# PROMO_BATCH_EPISODES=4           # episodes per Pass-1 call
# PROMO_JUDGE_BATCH=10             # clips per Pass-2 call
# PROMO_EARLY_EP_MAX=15            # episodes counted as a viable "entry point"
